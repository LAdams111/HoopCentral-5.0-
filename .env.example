# Local development
DATABASE_URL=postgresql://hoopcentral:hoopcentral@localhost:5432/hoopcentral
PORT=3001
NODE_ENV=development

# Railway sets these automatically when you link Postgres:
# DATABASE_URL=postgresql://...
# PORT= (set by Railway)
# RAILWAY_ENVIRONMENT=production

# Set FORCE_SEED=true to wipe and re-seed the database
# FORCE_SEED=true

# Required in production. Same value in Railway and every scraper's .env.
# Local dev works without it. Production refuses ingest until it is set.
# INGEST_API_KEY=your-secret-key
