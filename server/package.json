{
  "name": "@hoop-central/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate --config drizzle.config.cjs",
    "db:migrate": "tsx --tsconfig tsconfig.json ../scripts/migrate.ts",
    "db:push": "drizzle-kit push --config drizzle.config.cjs",
    "db:seed": "tsx --tsconfig tsconfig.json ../scripts/seed.ts",
    "db:ensure-teams": "tsx --tsconfig tsconfig.json ../scripts/ensure-teams.ts",
    "db:ensure-identities": "tsx --tsconfig tsconfig.json ../scripts/ensure-identities.ts",
    "db:test-ingest": "tsx --tsconfig tsconfig.json ../scripts/test-ingest.ts",
    "ingest:test-data": "tsx --tsconfig tsconfig.json ../scripts/ingest-test-data.ts",
    "ingest:verify": "tsx --tsconfig tsconfig.json ../scripts/ingest-verify.ts",
    "db:merge-seed-duplicates": "tsx --tsconfig tsconfig.json ../scripts/merge-seed-duplicates.ts",
    "db:merge-d2-duplicates": "tsx --tsconfig tsconfig.json ../scripts/merge-d2-duplicates.ts",
    "db:generate-ncaa-d2-conferences": "tsx --tsconfig tsconfig.json ../scripts/build-ncaa-d2-db-aliases.ts && python3 ../scripts/generate-ncaa-d2-conferences.py",
    "db:merge-ncaa-teams": "tsx --tsconfig tsconfig.json ../scripts/merge-ncaa-teams.ts",
    "db:merge-usports-teams": "tsx --tsconfig tsconfig.json ../scripts/merge-usports-teams.ts",
    "db:merge-ccaa-teams": "tsx --tsconfig tsconfig.json ../scripts/merge-ccaa-teams.ts",
    "db:cleanup-maxpreps-placeholders": "tsx --tsconfig tsconfig.json ../scripts/cleanup-maxpreps-placeholder-seasons.ts",
    "db:merge-montverde-hs-teams": "tsx --tsconfig tsconfig.json ../scripts/merge-montverde-hs-teams.ts",
    "db:studio": "drizzle-kit studio --config drizzle.config.cjs"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.39.3",
    "express": "^4.21.2",
    "pg": "^8.13.3",
    "tsx": "^4.19.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.10",
    "@types/pg": "^8.11.11",
    "drizzle-kit": "^0.30.4",
    "typescript": "^5.8.2"
  }
}
