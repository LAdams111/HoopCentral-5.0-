{
  "name": "@hoop-central/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate --config drizzle.config.cjs",
    "db:migrate": "tsx --tsconfig tsconfig.json ../scripts/migrate.ts",
    "db:push": "drizzle-kit push --config drizzle.config.cjs",
    "db:seed": "tsx --tsconfig tsconfig.json ../scripts/seed.ts",
    "db:ensure-teams": "tsx --tsconfig tsconfig.json ../scripts/ensure-teams.ts",
    "db:ensure-identities": "tsx --tsconfig tsconfig.json ../scripts/ensure-identities.ts",
    "db:test-ingest": "tsx --tsconfig tsconfig.json ../scripts/test-ingest.ts",
    "db:studio": "drizzle-kit studio --config drizzle.config.cjs"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.39.3",
    "express": "^4.21.2",
    "pg": "^8.13.3",
    "tsx": "^4.19.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.10",
    "@types/pg": "^8.11.11",
    "drizzle-kit": "^0.30.4",
    "typescript": "^5.8.2"
  }
}
